# Agent Society — LLM Provider Configuration
#
# Copy this to .env and fill in your API keys.
# Or use "Setup Provider" in the interactive CLI: npm run multiagent:society
#
# Heuristic mode (model: "heuristic-mini") needs no API key.
# LLM mode requires at least one provider.

# --- Anthropic (Claude models) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (GPT models) ---
# OPENAI_API_KEY=sk-...

# --- Custom endpoint (OpenAI-compatible, e.g. Ollama, vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
